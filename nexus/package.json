{
  "name": "nexus",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "start": "HOST=${HOST:-0.0.0.0} node .output/server/index.mjs",
